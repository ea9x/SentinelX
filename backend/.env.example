WHATWEB_PATH=
NUCLEI_PATH=
SSLYZE_PATH=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
